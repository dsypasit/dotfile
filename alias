# ---------- GitHub CLI helpers ----------
ghpr() {
	gh pr list --limit 100 --json number,title,updatedAt,author --template \
		'{{range .}}{{tablerow .number .title .author.name (timeago .updatedAt)}}{{end}}' |
		fzf-tmux -p 60%,40% --preview '' |
		cut -f1 -d ' ' |
		xargs gh pr checkout
}

ghw() {
	gh run list --limit 50 --json databaseId,workflowName,headBranch,status |
		jq -r '.[] | "\(.databaseId)\t[\(.status)] \(.workflowName) (\(.headBranch))"' |
		fzf --ansi \
			--preview 'gh run watch $(echo {} | cut -f1)' \
			--preview-window=up:80%:wrap \
			--bind "enter:execute-silent(gh run watch $(echo {} | cut -f1))"
}

# Pick workflows and run them on the production ref.
ghwf() {
	local selected_ids workflow_id
	selected_ids=$(gh workflow list --limit 100 --json name,id,state,path |
		jq -r '.[] | "\(.id)\t\(.name)\t\(.state)\t\(.path)"' |
		fzf -m --ansi --header="ID │ NAME │ STATE │ PATH" \
			--preview="echo {}" \
			--preview-window=down:3:wrap |
		cut -f1)

	if [ -z "$selected_ids" ]; then
		echo "No workflow selected."
		return 1
	fi

	echo "$selected_ids" | while read -r workflow_id; do
		echo "Running workflow '$workflow_id' on ref production"
		gh workflow run "$workflow_id" --ref production
	done
}

# Watch every in-progress run, one tmux pane per run.
ghwr() {
	local run_ids first_run window_id run_id
	run_ids=$(gh run list --json databaseId,status --jq '.[] | select(.status=="in_progress") | .databaseId')

	if [ -z "$run_ids" ]; then
		echo "No in-progress runs found."
		return 0
	fi

	first_run=$(echo "$run_ids" | head -n 1)
	window_id=$(tmux new-window -d -P -n "GH Runs" -F '#{window_id}' "gh run watch $first_run")

	echo "$run_ids" | tail -n +2 | while read -r run_id; do
		tmux split-window -v -t "$window_id" "gh run watch $run_id"
	done

	tmux select-layout -t "$window_id" tiled
	echo "Tmux window '$window_id' is ready. To attach, run: tmux select-window -t $window_id"
}

